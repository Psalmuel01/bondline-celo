# Public frontend configuration (Celo Sepolia is the safe default).
NEXT_PUBLIC_BONDLINE_NETWORK=celo-sepolia
NEXT_PUBLIC_CORE_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CIRCLE_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Server-only configuration. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
BONDLINE_SESSION_SECRET=replace-with-at-least-32-random-characters
BONDLINE_INDEXER_SECRET=replace-with-a-different-32-character-secret
CRON_SECRET=replace-with-an-optional-vercel-cron-secret
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
BONDLINE_DEPLOYMENT_BLOCK=0
BONDLINE_INDEXER_FINALITY_BLOCKS=12
BONDLINE_INDEXER_BLOCK_RANGE=2000
BONDLINE_INDEXER_LOG_RANGE=100
BONDLINE_APP_URL=https://your-celo-bondline.example

# Mainnet only: Sepolia deliberately uses standard JSON-RPC log fetching.
HYPERSYNC_BEARER_TOKEN=placeholder-envio-token
BONDLINE_HYPERSYNC_URL=https://celo.hypersync.xyz
BONDLINE_INDEXER_HYPERSYNC_BLOCK_RANGE=2000000
